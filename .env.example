# Copy this file to .env to override the local development defaults in
# docker-compose.yml. Use strong, unique secrets outside local development.

COMPOSE_PROJECT_NAME=risklens
BIND_ADDRESS=127.0.0.1

POSTGRES_DB=risklens
POSTGRES_USER=risklens
POSTGRES_PASSWORD=risklens_dev_password
POSTGRES_PORT=5432

NEO4J_USER=neo4j
NEO4J_PASSWORD=risklens_dev_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_VECTOR_SIZE=384
QDRANT_API_KEY=

BACKEND_PORT=8080
BACKEND_DATABASE_URL=postgresql://risklens:risklens_dev_password@postgres:5432/risklens
RISK_SERVICE_URL=http://risk-service:8000
BACKEND_REVIEW_THRESHOLD=0.75
BACKEND_REQUEST_TIMEOUT_SECONDS=5
VERIFIER_URL=http://ai-risk-verifier:8090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANALYST_ID=customer-support
NEXT_PUBLIC_HIGH_RISK_THRESHOLD=0.75
NEXT_PUBLIC_REFRESH_INTERVAL_MS=10000
NEXT_PUBLIC_API_TIMEOUT_MS=5000

VERIFIER_PORT=8090
VERIFIER_DATABASE_URL=postgresql://risklens:risklens_dev_password@postgres:5432/risklens
VERIFIER_QDRANT_URL=http://qdrant:6333
VERIFIER_API_KEY=
VERIFIER_SEED_DEFAULT_POLICIES=true
VERIFIER_BACKFILL_REVIEWED_CASES=true
VERIFIER_MEMORY_RECONCILIATION_INTERVAL_SECONDS=300
VERIFIER_RETRIEVAL_LIMIT=5
VERIFIER_RETRIEVAL_SCORE_THRESHOLD=0.08
VERIFIER_CONFIRMED_CASE_SIMILARITY_THRESHOLD=0.25
VERIFIER_FALSE_POSITIVE_SIMILARITY_THRESHOLD=0.32
VERIFIER_REQUEST_TIMEOUT_SECONDS=3

DATA_GENERATOR_UID=1000
DATA_GENERATOR_GID=1000
DATA_GENERATOR_BACKEND_URL=http://backend:8080
DATA_GENERATOR_COUNT=1000
DATA_GENERATOR_ABUSE_RATE=0.15
DATA_GENERATOR_SEED=42
DATA_GENERATOR_RATE=20
DATA_GENERATOR_CONCURRENCY=10
DATA_GENERATOR_RETRIES=2
DATA_GENERATOR_TIMEOUT=10

RISK_SERVICE_PORT=8000
RISK_DATABASE_URL=postgresql://risklens:risklens_dev_password@postgres:5432/risklens
RISK_NEO4J_URI=bolt://neo4j:7687
RISK_QDRANT_URL=http://qdrant:6333
RISK_VERIFIER_URL=http://ai-risk-verifier:8090
RISK_REQUIRE_VERIFIER=true
RISK_HISTORY_LIMIT=500
RISK_REQUEST_TIMEOUT_SECONDS=1.5
RISK_REVIEW_THRESHOLD=0.75
RISK_HOLD_THRESHOLD=0.82
RISK_DECLINE_THRESHOLD=0.95
RISK_SIMILARITY_THRESHOLD=0.15
RISK_AMOUNT_DEVIATION_RATIO=3.0
RISK_VELOCITY_5M_THRESHOLD=4
RISK_VELOCITY_1H_THRESHOLD=12
RISK_BENEFICIARY_ROTATION_5M_THRESHOLD=4
RISK_FRAGMENT_AMOUNT_CEILING=10000
RISK_FRAGMENT_COUNT_1H_THRESHOLD=4
RISK_FRAGMENT_TOTAL_1H_THRESHOLD=20000

EVALUATION_UID=1000
EVALUATION_GID=1000
EVALUATION_POSITIVE_DECISIONS=REVIEW,HOLD,DECLINED
# Leave blank to classify from decisions; set a value such as 0.70 to classify by score.
EVALUATION_SCORE_THRESHOLD=
EVALUATION_MIN_PRECISION=0
EVALUATION_MIN_RECALL=0
