{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risklens.local/schemas/transaction-request.schema.json",
  "title": "Transaction request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transactionId",
    "senderId",
    "receiverId",
    "amount",
    "currency",
    "paymentMethod",
    "timestamp"
  ],
  "properties": {
    "transactionId": {"type": "string", "minLength": 1, "maxLength": 64},
    "senderId": {"type": "string", "minLength": 1, "maxLength": 64},
    "receiverId": {"type": "string", "minLength": 1, "maxLength": 64},
    "amount": {"type": "number", "exclusiveMinimum": 0, "maximum": 9999999999999999.99},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "deviceId": {"type": ["string", "null"], "maxLength": 128},
    "ipAddress": {"type": ["string", "null"], "maxLength": 64},
    "paymentMethod": {"type": "string", "minLength": 1, "maxLength": 32},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
